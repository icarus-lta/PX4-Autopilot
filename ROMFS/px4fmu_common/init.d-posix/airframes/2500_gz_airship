#!/bin/sh
#
# @name Gazebo airship
#
# @type Airship
# @class Airship
#
# @maintainer Hyunduk Shin <hyunduk@icarus-airship.com>
#

. ${R}etc/init.d/rc.airship_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=lta}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=airship}

# Simulation only: allow arming without a GCS connection
param set-default NAV_DLL_ACT 0

# Map PX4 motor outputs to the gz motor plugins (Actuators message indices):
# channel 1 -> Motor1 (starboard, motorNumber 0), channel 2 -> Motor2 (port).
# MIN/MAX map PX4's [0..1] motor output u onto rotor velocity 0..300 rad/s;
# the plant then produces thrust 2e-4 * (300*u)^2 = 18*u^2 N per prop.
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MAX1 300
param set-default SIM_GZ_EC_MAX2 300

# Map PX4 servo outputs to the tilt pods (bridge topic
# /model/<model>/servo_{0,1}, radians into the joint position
# controllers). The angle map is declared in DEGREES and spans the
# full output range: value -1..+1 -> -180..+180 deg, so 0 = thrust
# forward, +0.5 = +90 (up), +-1 = reverse. The +-180 range is the
# spec-pending placeholder; tighten MINA/MAXA when the vehicle's
# tilt limits arrive. Servo 1 = starboard pod, servo 2 = port pod.
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_FUNC2 202
param set-default SIM_GZ_SV_MINA1 -180
param set-default SIM_GZ_SV_MAXA1 180
param set-default SIM_GZ_SV_MINA2 -180
param set-default SIM_GZ_SV_MAXA2 180

# Control allocation: two fixed forward thrusters on a transverse rod
# through the center of mass (fixed-tilt increment of the vectored
# side-propulsion configuration - per-thruster tilt actuation is a
# later increment).
#   Fx = collective thrust      Mz = differential thrust
# The thrust line passes THROUGH the CoM (arm 0.00 m), so forward thrust
# produces no pitch response. Pitch and roll have no effector; the
# buoyancy righting moment keeps them passively stable. The tail fins
# produce no force in still indoor air, so they are not allocated (they
# stay visual-only in the model).
#   CT 18       max static thrust [N] at full output; the allocator
#               linearizes the plant's quadratic 18*u^2 curve (exact at u=1)
#   PY +-1.5    lateral offset [m, FRD: +y = starboard]
#               -> yaw effectiveness -+ 1.5*18 = -+27 N*m
#   KM 0        prop reaction torque ignored (opposite-turning pair;
#               |0.016*T| is ~1% of the differential yaw authority)
param set-default CA_AIRFRAME 9
param set-default CA_ROTOR_COUNT 2
param set-default CA_ROTOR0_AX 1
param set-default CA_ROTOR0_AZ 0
param set-default CA_ROTOR0_KM 0
param set-default CA_ROTOR0_PY 1.5
param set-default CA_ROTOR0_CT 18
param set-default CA_ROTOR1_AX 1
param set-default CA_ROTOR1_AZ 0
param set-default CA_ROTOR1_KM 0
param set-default CA_ROTOR1_PY -1.5
param set-default CA_ROTOR1_CT 18
