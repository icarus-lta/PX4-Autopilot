#!/bin/sh
#
# @name Cloudship
# @type Airship
# @class Airship
#
# @output Motor1 starboard thruster
# @output Motor2 port thruster
# @output Motor3 tail thruster
# @output Servo1 thrust tilt
#
# @board px4_fmu-v2 exclude
# @board bitcraze_crazyflie exclude
#

. ${R}etc/init.d/rc.airship_defaults

param set-default COM_PREARM_MODE 2

# One collective thrust and tilt command with a reversible tail yaw
# thruster. The symmetric range keeps level thrust at servo output 0,
# matching the original mixer calibration; the tilt range and slew rate
# are assumed, not measured on the Cloudship.
param set-default CA_AIRFRAME 16
param set-default CA_AIRSHIP_GRP 0
param set-default CA_AIRSHIP_TAIL 1
param set-default CA_AIRSHIP_TLMIN -90
param set-default CA_AIRSHIP_TLMAX 90
param set-default CA_AIRSHIP_TLT_R 120

param set-default CA_R_REV 4

# Set THR_MDL_FAC from the measured thrust curve before trusting the yaw
# gains. The SITL twin (2510_gz_cloudship) sets THR_MDL_FAC 1 because the gz
# motor model is exactly quadratic in rotor speed, which makes thrust linear
# in the command there, and the AS_YAWRATE_* defaults were checked on that
# linear plant. This file leaves the parameter at its default of 0, so on the
# vehicle the ESC and prop curve is whatever it is, and a unit of yaw command
# buys less thrust at low throttle than the gains were tuned for. Measure the
# curve, set the factor, retune.
